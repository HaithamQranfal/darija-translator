@startuml use-case-diagram
title Darija Translator - Use Cases
left to right direction
skinparam shadowing false
actor "User" as U
actor "Gemini / Ollama LLM" as L <<system>>
rectangle "Darija Translator system" {
  usecase "Translate text to Darija" as UC1
  usecase "Translate selected web text\n(context menu / Ctrl+Shift+Y)" as UC2
  usecase "Auto-paste selected text\nin side panel" as UC3
  usecase "Voice-to-voice translation" as UC4
  usecase "Read translation aloud (TTS)" as UC5
  usecase "Copy translation" as UC6
  usecase "View history" as UC7
  usecase "Configure server & credentials" as UC8
  usecase "Authenticate (HTTP Basic)" as UC9
}
U --> UC1
U --> UC2
U --> UC4
U --> UC5
U --> UC6
U --> UC7
U --> UC8
UC2 ..> UC1 : <<include>>
UC2 ..> UC3 : <<include>>
UC4 ..> UC1 : <<include>>
UC4 ..> UC5 : <<include>>
UC1 ..> UC9 : <<include>>
UC1 --> L
@enduml
